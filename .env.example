# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored, so your credentials stay local.
#
# PostgreSQL connection string used by every script in src/ingestion/ and by
# the Airflow connection `warehouse_conn`.
#
#   postgresql://<user>:<password>@<host>:<port>/<database>
PULSETRACK_DB_URI=postgresql://postgres:your_password_here@localhost:5432/pulsetrack_raw
